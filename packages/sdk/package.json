{
  "name": "@yantra/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/spec-index.json": "./src/generated/spec-index.json"
  },
  "scripts": {
    "generate": "python ../../tools/generate_architecture_sdk.py",
    "build": "tsc -p tsconfig.json",
    "test": "node --test ./tests/*.test.mjs",
    "check": "npm run generate && npm run build && npm run test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}